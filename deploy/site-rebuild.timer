[Unit]
Description=Періодичний ребілд статичного сайту PlutusToys (свіжі ціни/наявність)

[Timer]
# кожні 2 год (12 разів на день), о :20 щоб не збігатися з іншими юнітами. БУЛО кожні 6 год — товар, що закінчився на
# Toysi, лишався на сайті до 6 год (рішення власника 2026-10-06: скоротити). Перебудова ≈1.5-3 хв.
OnCalendar=*-*-* 00/2:20:00
# «Знижка тижня» (власник 14.10; з 15.10 ПОСТІЙНА: щоденні партії на 8 діб, Code-Agent): партія діє з 00:00:00 по 23:59:59 за Києвом; щоденний ребілд о 00:00:30 вмикає нову партію й прибирає прострочену за ~30 с (було лише понеділок, тоді нова партія з'являлась би з затримкою до 2 год — Код 15.10). Часовий пояс вказано явно (Europe/Kyiv), як у site-sale-plan.timer. УВАГА: каталог deploy/ не синхронізується автоматично — оновлений unit треба скопіювати на VPS і перезапустити таймер (systemctl daemon-reload && systemctl restart site-rebuild.timer).
OnCalendar=*-*-* 00:00:30 Europe/Kyiv
Persistent=true

[Install]
WantedBy=timers.target
