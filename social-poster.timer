[Unit]
Description=PlutusToys: Mon/Wed/Fri trigger for Facebook auto-post (social_auto_poster --publish)

[Timer]
# 3 пости/тиждень (рішення власника 2026-08-14): Пн/Ср/Пт об 11:00 системного часу VPS
# (Europe/Kyiv, EEST) — активний час у соцмережах. --limit 1 у сервісі → рівно 1 пост
# за спрацювання. Точна хвилина не важлива (RandomizedDelaySec розмиває).
OnCalendar=Mon,Wed,Fri *-*-* 11:00:00
# Наздогнати пропущене, якщо VPS був вимкнений у момент спрацювання (ledger не дасть
# дублів — уже постнутий SKU пропускається).
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
