[Unit]
Description=PlutusToys site rebuild — регенерація статичного магазину з живого каталогу Toysi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/plutustoys
# venv-python (CLAUDE.md); build_site.py оновлює site/*.html + index.json + sitemap.xml.
# site_order_api сам підхоплює новий index.json (price_map кеш по mtime) — рестарт не потрібен.
ExecStart=/opt/plutustoys/venv/bin/python3 /opt/plutustoys/site/build_site.py
# оновити 301-мапи старих Prom-URL (GMC): nginx-формат + Apache-формат (VPS = Apache/Webuzo).
# Apache RewriteMap txt: сам перечитує файл за зміною mtime — reload НЕ потрібен.
# '-' → не-фатально: збій цього кроку не валить ребілд сайту.
ExecStartPost=-/opt/plutustoys/venv/bin/python3 /opt/plutustoys/generate_prom_redirects.py
# канарка старих Prom-URL на ЖИВОМУ сайті (11.10.2026): покритий prom_id → 301 на картку, вигаданий → 410 (порожня/зіпсована мапа дала б 410 для всіх) →
# тротлений алерт у Telegram. '-' → не-фатально. Має сенс лише після застосування Apache-правил 410 (activate_site_apache.sh) — разом із цим юнітом.
ExecStartPost=-/opt/plutustoys/venv/bin/python3 /opt/plutustoys/site_redirect_canary.py
Nice=10
