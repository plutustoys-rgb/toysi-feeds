[Unit]
Description=PlutusToys: 1x/day trigger for Instagram auto-post (social_auto_poster --target ig)

[Timer]
# Instagram — 1 пост/день (7/тиждень), рішення власника 19.08 (замінює найновіше-40 у частині IG).
# ПРИЧИНА: за 28 днів охоплення IG = 2 людини, 95% переглядів — від наших 2 підписників, 3
# взаємодії; кожна додаткова однотипна картка з нульовою залученістю псує ранжування наступній →
# ріжемо обсяг, а не нарощуємо (аналіз SMM, Meta Business Suite). Лишаємо 18:00, прибираємо 12:00.
# 18:00 системного часу VPS (EEST). Свідомо НЕ 11:00 (час FB) — щоб прогони не збіглись за ledger;
# плюс файловий lock у скрипті — подвійний захист.
OnCalendar=*-*-* 18:00:00
# Наздогнати пропущене (ledger не дасть дублів; lock — від збігу з FB на буті).
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
