[Unit]
Description=PlutusToys: ТОП Toysi (відвантажень / вчора / 7 / 30 днів) → site/toysi_top.json (toysi_top.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/plutustoys
# КРИТИЧНО (CLAUDE.md): venv-python. 4 публічні сторінки toysi.ua; пише site/toysi_top.json (публічний: id товарів у порядку Toysi, без цін/собівартості).
ExecStart=/opt/plutustoys/venv/bin/python3 /opt/plutustoys/toysi_top.py
TimeoutStartSec=420
Nice=10
