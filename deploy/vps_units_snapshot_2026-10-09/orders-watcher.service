[Unit]
Description=PlutusToys orders_watcher - poll Prom/Rozetka for new orders
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/plutustoys
ExecStart=/opt/plutustoys/venv/bin/python /opt/plutustoys/orders_watcher.py
StandardOutput=journal
StandardError=journal
