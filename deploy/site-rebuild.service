[Unit]
Description=PlutusToys site rebuild — регенерація статичного магазину з живого каталогу Toysi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/plutustoys
# venv-python (CLAUDE.md); build_site.py оновлює site/*.html + index.json + sitemap.xml.
# site_order_api сам підхоплює новий index.json (price_map кеш по mtime) — рестарт не потрібен.
ExecStart=/opt/plutustoys/venv/bin/python3 /opt/plutustoys/site/build_site.py
# оновити 301-мапу старих Prom-URL (GMC) і перечитати nginx, щоб підхопив нові редиректи.
# '-' → не-фатально: збій цих кроків не валить ребілд сайту.
ExecStartPost=-/opt/plutustoys/venv/bin/python3 /opt/plutustoys/generate_prom_redirects.py
ExecStartPost=-/bin/systemctl reload nginx
Nice=10
