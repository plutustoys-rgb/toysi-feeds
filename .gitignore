rozetka_category_rz_id_map.json

# Runtime-стан vps_code_sync.sh (2026-07-27) — {last_run, last_status,
# last_commit, last_success_commit, reason, changed_files} для кожного
# прогону автопулу /opt/plutustoys. Читає check_autodeploy_status() у
# service_watchdog.py — суто локальний runtime-маркер, не round-trip
# через жодну гілку.
vps_code_sync_state.json

# Знахідка аудиту pt3 (2026-07-27): каталог з ПРИВАТНИМ read-only deploy-
# ключем vps-pull-deploy для vps_code_sync.sh — після Кроку 1 runbook'у
# /opt/plutustoys стає справжнім git working directory, і без цього
# запису будь-яка майбутня ручна дія (git add -A під час обслуговування
# тощо) могла б випадково застейджити приватний ключ у публічний репо.
.ssh_deploy_pull/

# Каталог з ПРИВАТНИМ write-only (лише feed-data) deploy-ключем
# vps-feed-publish для publish_feed_pipeline_vps.sh — той самий принцип,
# що й .ssh_deploy_pull/ вище.
.ssh_feed_publish/

# Runtime-стан run_feed_pipeline_vps.sh (Фаза 2, 2026-07-27) —
# {last_run, last_status (ok/degraded/failed), reason} для кожного
# прогону VPS-фід-пайплайну. Читає check_feed_pipeline_vps_status() у
# service_watchdog.py (знахідка аудиту pt6 — замінює check_feed_pipeline_schedule(),
# яка стала непридатною, щойно schedule: в update-feeds.yml закоментовано).
feed_pipeline_state.json

# ЗНАХІДКА (2026-07-27, живо після Кроку 1 автодеплою — власниця побачила
# в `git status` на VPS): клієнтський сертифікат NovaPay
# (NOVAPAY_CERT_PATH, novapay_client.py) і його бекапи НЕ були покриті
# жодним існуючим записом — на відміну від .env/*_state.json вище.
# Репозиторій ПУБЛІЧНИЙ: будь-який майбутній `git add -A` на VPS миттєво
# й незворотно розкрив би приватний сертифікат. Wildcard покриває сам
# файл і всі спостережені варіанти бекапів (.bak/.old_pubkey/.save).
novapay_cert.pem*

# Стандартний venv-каталог (Python) — ніколи не для git, той самий
# принцип, що й __pycache__/ вище.
venv/

# Загальні бекап-артефакти, знайдені на VPS 2026-07-27 (ручні копії "про
# всяк випадок" під час обслуговування) — не код, не потрібні в git.
*.bak*
_backup_*/
_drift_backup_*/

