[Unit]
Description=PlutusToys: щоденний звіт про статус і причини відхилення товарів Google Merchant Center (gmc_status_report.py, лише читання)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/plutustoys
# КРИТИЧНО (CLAUDE.md): venv-python. Потрібні ключ /opt/plutustoys/.secrets/gmc_service_account.json (створює власник; .secrets/ у .gitignore), одноразова реєстрація GCP-проєкту в Merchant API і пакет google-auth у venv. Без ключа скрипт пише підказку й завершується кодом 0.
ExecStart=-/opt/plutustoys/venv/bin/python3 /opt/plutustoys/gmc_status_report.py
# Знімок налаштувань акаунта GMC (gmc_account_settings.py, лише читання, запит SEO 16.10): зміна проти попереднього дня → gmc_settings_changes_<дата>.txt.
ExecStart=-/opt/plutustoys/venv/bin/python3 /opt/plutustoys/gmc_account_settings.py
# Щоденне зведення Googlebot з Apache-логів (читання, запит SEO 15.10): ТРЕТІЙ крок без «-»: збій звіту Merchant Center (перший, з «-») його не блокує, а власний збій зведення Googlebot видно в статусі служби (systemctl --failed).
ExecStart=/opt/plutustoys/venv/bin/python3 /opt/plutustoys/googlebot_log_report.py 14
# Знімок Google Search Console для SEO (gsc_report.py, лише читання, запит SEO 15.10): ОСТАННІЙ крок, щоб його повільні запити (бюджет inspect 700 с) не позбавили часу Googlebot-крок; з «-»: сам шле алерт про збій частин; API вимкнено → мовчки код 0 (очікувано до дії власника).
ExecStart=-/opt/plutustoys/venv/bin/python3 /opt/plutustoys/gsc_report.py
TimeoutStartSec=1500
Nice=10
