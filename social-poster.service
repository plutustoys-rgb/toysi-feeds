[Unit]
# PlutusToys — автопост товару на Facebook-Сторінку (3×/тиждень через таймер).
# Запускає social_auto_poster.py --limit 1 --publish: бере наступний ще-не-постнутий
# ЖИВИЙ товар з feeds/meta_feed.xml (перевіряє 200 перед постом), публікує фото+підпис
# на Сторінку через Graph API /{page-id}/photos, позначає в social_posted_ledger.json
# (без повторів). Деплой: копія в /etc/systemd/system/,
# `systemctl daemon-reload && systemctl enable --now social-poster.timer`.
Description=PlutusToys: Facebook Page auto-post (social_auto_poster.py --limit 1 --publish)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/plutustoys
# КРИТИЧНО (CLAUDE.md): venv-python (має python-dotenv/requests; голий python3 впаде).
# Робоча тека /opt/plutustoys — щоб .env (FB_PAGE_ID/FB_PAGE_ACCESS_TOKEN),
# feeds/meta_feed.xml і social_posted_ledger.json резолвились.
ExecStart=/opt/plutustoys/venv/bin/python3 /opt/plutustoys/social_auto_poster.py --limit 1 --publish
# Не критичний сервіс: помилка лише логується в journal. Без токена — тихий no-op
# (нічого не постить). 3 невдачі поспіль → скрипт сам зупиняється (стоп-гард).
TimeoutStartSec=600
