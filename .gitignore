.env

# Тимчасове локальне сховище для щойно згенерованих приватних ключів
# (напр. vps-pull-deploy, 2026-07-27) до передачі власниці й видалення —
# ніколи не для git, той самий принцип, що й .env вище.
.local_secrets/

__pycache__/
*.pyc

# Локальний кеш каталогу Toysi (десятки МБ, генерується скриптами наново)
toysi_catalog_cache.json

# Локальний стан конкурентного ціноутворення (не для публічного репо)
competitor_pricing_checkpoint.json
pricing_results.csv
pricing_results_v1_legacy_backup.csv
pricing_results_pre_migration_backup.csv
price_corrections.csv

# Дебаг/скретч-файли
debug_page.html
debug_screenshot.png
scratch_search.html
scratch_product.html

# Локальна БД замовлень (runtime-стан, не для git)
orders.db
prom_chat.db

# PDF-етикетки Укрпошти — персональні дані клієнтів (ім'я/адреса/телефон)
ukrposhta_stickers/

# Runtime-стан service_watchdog.py (OK/ALARM по кожному сервісу)
watchdog_state.json

# Runtime-стан і звіти prom_catalog_auditor.py (генеруються наново на VPS,
# не для git — reports/ містить щоденні звіти, state.json — трекінг "перша
# поява проблеми" для порогу 24 год)
prom_catalog_audit_state.json
reports/

# Runtime-стан мосту prom_competitor_pricer.py (пише) <-> generate_prom_feed.py
# (читає) — {external_id: {price, timestamp}} для щойно застосованих
# конкурентних цін, плюс _meta.last_full_run для гейту "не частіше ~20 год".
# Мігровано на GitHub Actions 2026-07-13: обидва скрипти тепер виконуються як
# кроки в тому самому job update-feeds.yml (спільна файлова система job'у),
# а сам файл round-trip'иться між прогонами через гілку feed-data (окремий
# крок відновлює його з попереднього коміту перед запуском репрайсера,
# крок публікації додає його назад) — не через master і не через VPS.
prom_competitor_price_state.json

# Стислий людський підсумок останнього прогону репрайсера (не для коду) —
# НЕ публікується в feed-data (та гілка вже публічна, а тут стратегічні
# лічильники репрайсера — той самий тип сигналу про ціноутворення, який
# раніше вирішили не публікувати відкрито). Замість цього — приватний
# GitHub Actions artifact (update-feeds.yml), доступний лише через
# автентифікований `gh run download`; синхронізація в спільну Windows-теку
# PlutusToys_avtonomiya — вручну, коли активна Claude-сесія (той самий
# підхід, що й prom_catalog_audit_summary.md там).
prom_competitor_pricer_summary.md

# Runtime-стан одноразового скану повного каталогу (full_catalog_competitor_
# scan.py, 2026-07-13) — {sku: {cost, category_name, competitor_price,
# competitor_score, margin_pct, price_category}} для ~17 000 eligible SKU,
# готує дані для побудови нового топ-1000. Round-trip'иться через ОКРЕМУ
# гілку full-catalog-scan-data (full-catalog-scan.yml) — НЕ feed-data (та
# гілка публічна й force-push на неї замінив би live-фіди/стан репрайсера).
full_catalog_scan_state.json

# ЗАМІНЕНО (2026-07-27) на rozetka_static_selection.json нижче —
# select_top_items()/грейс-період для Rozetka прибрано повністю (пряме
# рішення власниці, див. generate_rozetka_feed.py). Код більше не пише
# цей файл, але запис лишається (defense in depth) — старі копії
# можуть і далі лежати на VPS/інших чекаутах, не для git у будь-якому разі.
rozetka_feed_membership_state.json

# Заморожений, ОДНОРАЗОВО сформований статичний відбір для Rozetka
# (2026-07-27, пряме рішення власниці — незалежно від Prom, без
# ротації, "навіть без перевірки складу, поки не пройшли модерацію") —
# {items, prices, built_at}. НЕ для git як файл (специфічний для
# конкретного акаунту знімок), АЛЕ round-trip'иться через feed-data
# (знахідка аудиту pt7 — без цього round-trip файл ніколи не пережив би
# ефемерний GH Actions runner, і "заморожування" виконувалось би заново
# щопрогону) — той самий принцип, що й prom_competitor_price_state.json/
# own_product_links_cache.json. Видалення файлу (і в git-history гілки
# feed-data) — єдиний спосіб змусити наступний прогін перебудувати
# список з нуля.
rozetka_static_selection.json

# Заморожений, ОДНОРАЗОВО сформований статичний знімок для EVA (2026-07-29,
# пряме рішення власниці — сплачена реєстрація EVA, каталог подано на
# модерацію) — {items, prices, russian_names, built_at}. Той самий
# принцип, що й rozetka_static_selection.json вище: не для git як файл,
# АЛЕ round-trip'иться через feed-data (run_feed_pipeline_vps.sh
# відновлює, publish_feed_pipeline_vps.sh публікує) — VPS-диск і так
# переживає між прогонами, round-trip тут лише додатковий захист від
# втрати диска. Видалення файлу (і в git-history гілки feed-data) —
# єдиний спосіб змусити наступний прогін перебудувати список з нуля,
# коли власниця підтвердить завершення модерації EVA.
eva_static_selection.json
# eva_listed_state.json — локальний стан «коли-небудь листованих» EVA-товарів для
# деактивації OOS (generate_eva_feed.py, PR #209): account-specific, перебудовується
# щопрогону, не для git (той самий принцип, що eva_static_selection.json вище).
eva_listed_state.json

# Заморожений статичний знімок для АЛЛО (2026-07-30, пряме рішення власниці —
# канал у стані реєстрації/модерації). Той самий принцип, що
# eva_static_selection.json / rozetka_static_selection.json вище: не для git як
# файл (специфічний для акаунту знімок). ALLO ще НЕ підключений до пайплайну
# (feeds/allo_feed.xml не публікується) — коли підключать, додати restore/publish
# round-trip через feed-data (як для EVA в run_feed_pipeline_vps.sh). Видалення
# файлу — єдиний спосіб перебудувати список, коли модерацію АЛЛО завершать.
allo_static_selection.json

# Резюмований прогрес РУЧНОГО, разового apply_live_dumping_fix.py
# (2026-07-26) — {started_at, done_pids} для ПОТОЧНОГО sweep'у, щоб
# повторний ручний запуск міг продовжити, а не починати каталог заново.
# Суто локальний runtime-маркер одного ручного контролера, не round-trip
# через жодну гілку (на відміну від prom_competitor_price_state.json) —
# скидається автоматично, щойно sweep повністю покрито.
live_dumping_fix_progress.json

# Лічильник "застряг N прогонів" для SKU, які Prom API мовчки/явно
# відмовляється видаляти (2026-07-21, findings_log.md
# "prom-delete-still-rejected-for-specific-sku") — суто runtime-трекінг
# послідовних невдалих спроб prom_catalog_sync.py, не для git.
prom_catalog_sync_stuck_state.json

# 24-год throttle останнього блок-алерту deletion_guard (2026-07-30) — суто
# runtime-стан prom_catalog_sync.py, скидається при здоровому прогоні, не для git.
prom_catalog_sync_block_alert_state.json

# Sweep-курсор супплементу "невидимої групи" (2026-07-30, STATUS.md п.6) — які
# desired-id уже перевірено через by_external_id у поточному циклі, для гарантованого
# прогресу по бэклогу. Суто runtime-стан, скидається на новий цикл, не для git.
prom_cabinet_supplement_checked.json

# КОДВ-журнал (daily_report.py, 2026-07-20) — накопичувальний, живе на
# VPS, публікується publish_kodv_ledger.sh в ОКРЕМУ гілку kodv-ledger-data
# (НЕ feed-data — той самий принцип ізоляції, що й full_catalog_scan_state.json
# вище: два незалежні force-push-публікатори на ОДНУ гілку затирали б один
# одного; тут іще важливіше, бо це фінансові дані, які force-push взагалі
# не повинен зачіпати — publish_kodv_ledger.sh комітить з реальною історією,
# не force-push).
kodv_ledger.jsonl

# Запобіжник: файл з паролями не повинен потрапити в git навіть випадково
паролі.txt

# Згенеровані фіди (десятки МБ кожен) — публікуються тільки в гілку feed-data
# (force-push, без історії), у master/main їм не місце
feeds/*.xml

# VPS-доступ (пароль root) — лише локально, ніколи в git
vps_access.local.md

